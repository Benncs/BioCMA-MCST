<?xml version="1.0" encoding="UTF-8" ?>
<cases>
   <control name="debug">
    <cma_case_path>./cma_data/0d_gas/</cma_case_path>
      <final_time>100</final_time>
      <number_particle>50</number_particle>
      <delta_time>0.1</delta_time>
      <results_file_name>results/debug/debug</results_file_name>
      <number_exported_result>10</number_exported_result>
      <model_name>fixed_length</model_name>

   </control>

   <control name="n14">
      <cma_case_path
            recursive="true"
        >/tmp/bench/</cma_case_path>
      <final_time>10</final_time>
      <number_particle>50000</number_particle>
      <delta_time>0.1</delta_time>
      <results_file_name>debug_docker</results_file_name>
      <number_exported_result>20</number_exported_result>
      <model_name>two_meta_div</model_name>
   </control>

   <control name="docker">
      <cma_case_path>/opt/biomc/ccma_data/0d_gas/</cma_case_path>
      <final_time>400</final_time>
      <number_particle>5000</number_particle>
      <delta_time>0.1</delta_time>
      <results_file_name>docker_results</results_file_name>
      <number_exported_result>100</number_exported_result>
      <model_name>two_meta</model_name>
      <initialiser_path>/opt/biomc/cma_data/0d_4s_init.h5</initialiser_path>
   </control>

</cases>
